# Python
__pycache__/
*.pyc
.venv/
venv/

# Data (raw/processed data is not committed by default)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/

# Demo artifacts: committed so the app runs immediately after a clone,
# without requiring the raw datasets or a full pipeline run. Everything
# else in data/processed/ stays regenerated by the pipeline scripts.
!data/processed/tickets_clustered.csv
!data/processed/tfidf_vectorizer.joblib
!data/processed/tfidf_matrix.joblib
!data/processed/clusterer.joblib
!data/processed/feature_builder.joblib
!data/processed/models/
!data/processed/models/logistic_regression.joblib
!data/processed/models/decision_tree.joblib
!data/processed/models/random_forest.joblib

# Keep the presentation theme; other Streamlit settings remain local.
!.streamlit/
.streamlit/*
!.streamlit/config.toml

# Local setup and application caches
.cache/
.pytest_cache/
